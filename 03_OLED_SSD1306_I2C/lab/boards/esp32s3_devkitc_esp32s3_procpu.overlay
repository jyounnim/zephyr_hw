/*
 * ESP32-S3-DevKitC-1: enable I2C0 and rewire it to SDA=GPIO8/SCL=GPIO9.
 *
 * This is the same series-wide GPIO8/9 override used by Lab 01 and
 * Lab 02 (and, since 2026-09-01, the parked SSD1306 I2C attempt too) -
 * re-declaring the i2c0_default pinctrl node under the same name lets
 * this overlay's properties win over the board's own default
 * (SDA=GPIO1/SCL=GPIO2) per Zephyr's devicetree merge rules. See Lab
 * 01's doc for the full explanation of why re-declaring under the same
 * node name (rather than dropping this &pinctrl block) is what
 * actually takes effect.
 *
 * No child devicetree node for the OLED: this lab talks to the SSD1306
 * directly over raw I2C (main.c issues its own command/data writes),
 * rather than using Zephyr's in-tree "solomon,ssd1306" display driver.
 * This is deliberate - the SSD1306 ships at either 0x3C or 0x3D
 * depending on the module's SA0 strap, and a devicetree node's `reg`
 * (I2C address) is fixed at build time. Since this lab's whole point is
 * to *scan* for the address at boot and use whichever one responds
 * (see main.c), a static devicetree binding doesn't fit - same
 * reasoning Lab 02 used for the raw-I2C PCF8574 LCD backpack.
 *
 * clock-frequency: standard 100 kHz. If you see white noise or garbled
 * frames on real hardware, this series has previously traced that
 * symptom (on the same SSD1306 I2C module family) to weak/missing
 * pull-ups rather than clock speed - try adding external 4.7k-ohm
 * pull-ups on SDA/SCL to 3.3V before lowering this value.
 */

&pinctrl {
	i2c0_default: i2c0_default {
		group1 {
			pinmux = <I2C0_SDA_GPIO8>, <I2C0_SCL_GPIO9>;
			bias-pull-up;
			drive-open-drain;
			output-high;
		};
	};
};

&i2c0 {
	status = "okay";
	clock-frequency = <100000>;
	pinctrl-0 = <&i2c0_default>;
	pinctrl-names = "default";
};
