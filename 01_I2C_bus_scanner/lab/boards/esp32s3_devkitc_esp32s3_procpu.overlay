/*
 * Enables I2C0 on esp32s3_devkitc.
 *
 * VERIFY BEFORE USE: some ESP32-S3 Zephyr board files already define a
 * default pinctrl state for i2c0 (status left "disabled" until you flip
 * it). Others don't define one at all, and you must add it yourself via
 * ESP32_PINMUX() macros. Check your board's own .dts first:
 *
 *   west build -t devicetree
 *   (then search build/zephyr/zephyr.dts for "i2c0" and "i2c0_default")
 *
 * If pinctrl-0 = <&i2c0_default> already resolves without you defining
 * it here, delete the &pinctrl block below and keep only the &i2c0 block.
 */

&pinctrl {
	i2c0_default: i2c0_default {
		group1 {
			pinmux = <I2C0_SDA_GPIO8>, <I2C0_SCL_GPIO9>;
			bias-pull-up;
			drive-open-drain;
			output-high;
		};
	};
};

&i2c0 {
	status = "okay";
	clock-frequency = <I2C_BITRATE_STANDARD>;
	pinctrl-0 = <&i2c0_default>;
	pinctrl-names = "default";
};
