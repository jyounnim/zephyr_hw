/*
 * ESP32-S3-DevKitC-1: enable I2C0 and rewire it to SDA=GPIO8/SCL=GPIO9.
 *
 * 2026-09-01 update: this lab originally relied on the board's own
 * pinctrl (esp32s3_devkitc-pinctrl.dtsi), which wires i2c0_default to
 * SDA=GPIO1/SCL=GPIO2 out of the box - so the overlay only had to flip
 * status to "okay". This series has since standardized on SDA=GPIO8/
 * SCL=GPIO9 for I2C0 across all labs (matching Lab 01's wiring and the
 * ESP32-S3 Arduino Wire.begin() default), so this overlay now
 * re-declares the i2c0_default pinctrl node under the same name to
 * redirect it to GPIO8/9 - see Lab 01's doc for why re-declaring under
 * the same node name (rather than dropping the &pinctrl block) is what
 * actually takes effect: Zephyr's devicetree merge rules let a later
 * property declaration win, so keeping this block is what overrides
 * the board default instead of silently falling back to it.
 *
 * No child devicetree node for the LCD: this lab talks to the PCF8574
 * I2C backpack directly over raw I2C (main.c uses i2c_write() with
 * the address picked at runtime from the bus scan), so there is no
 * Zephyr driver to bind a node to.
 *
 * clock-frequency is left at the standard 100 kHz. Unlike the SSD1306
 * OLED lab (128x64 = 1024 bytes per full-screen update), a character
 * LCD write here is 1 byte at a time over 4-bit nibbles - a few dozen
 * bits per character - so it is far less sensitive to marginal signal
 * integrity on a breadboard. Still, if you see garbled/missing
 * characters, the same fix applies: add external 4.7k-ohm pull-ups
 * on SDA/SCL to 3.3V (do not pull up to 5V, see the KR doc's power
 * note) rather than relying on the ESP32-S3's weak internal ones.
 */

&pinctrl {
	i2c0_default: i2c0_default {
		group1 {
			pinmux = <I2C0_SDA_GPIO8>, <I2C0_SCL_GPIO9>;
			bias-pull-up;
			drive-open-drain;
			output-high;
		};
	};
};

&i2c0 {
	status = "okay";
	clock-frequency = <100000>;
	pinctrl-0 = <&i2c0_default>;
	pinctrl-names = "default";
};
