/*
 * ESP32-S3-DevKitC-1: SPI2 (GPSPI2) TFT panel wiring for the
 * ST7789V3-driven 1.69" 240x280 display.
 *
 * Pin reuse: this lab intentionally reuses the exact same SPI2 pin
 * assignment as the ST7735 lab in this series (SCLK=GPIO14,
 * MOSI=GPIO13, CS0=GPIO15, RST=GPIO16, DC=GPIO17) - both are raw-SPI
 * color TFT panels with the same RST/DC needs, so the breadboard
 * wiring from that lab can be reused as-is, no rewiring needed.
 * Hardware CS0 is used (SPIM2_CSEL_GPIO15 pinmux), matching this
 * series' SPI2 convention. MISO is intentionally not wired - this
 * panel is write-only from the MCU's side.
 *
 * No Zephyr in-tree display driver is used - see the zds,st7789v
 * custom binding (lab/dts/bindings/display/zds,st7789v.yaml) and
 * main.c, which talks to the panel directly over raw SPI.
 */

&pinctrl {
	spim2_default: spim2_default {
		group1 {
			pinmux = <SPIM2_SCLK_GPIO14>, <SPIM2_MOSI_GPIO13>, <SPIM2_CSEL_GPIO15>;
		};
	};
};

&spi2 {
	status = "okay";
	pinctrl-0 = <&spim2_default>;
	pinctrl-names = "default";

	st7789v_disp: st7789v@0 {
		compatible = "zds,st7789v";
		reg = <0>;
		spi-max-frequency = <20000000>;
		reset-gpios = <&gpio0 16 GPIO_ACTIVE_LOW>;
		dc-gpios = <&gpio0 17 GPIO_ACTIVE_HIGH>;
		width = <240>;
		height = <280>;
		x-offset = <0>;
		y-offset = <20>;
	};
};
